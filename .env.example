# Nilai awal konfigurasi dashboard (opsional). Semua bisa ditimpa lewat halaman Pengaturan.
# Salin ke `.env` lalu sesuaikan. JANGAN commit `.env` berisi nilai nyata.

# Base URL API JalurKu (prefix /api/v1 ditambahkan otomatis oleh aplikasi).
VITE_API_BASE_URL=http://localhost:8000

# Versi consent default untuk pembuatan sesi tamu.
VITE_CONSENT_VERSION=2026-10-13
